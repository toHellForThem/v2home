#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/v2home

start_service() {
	local listen log_level

	config_load v2home
	config_get listen main listen "0.0.0.0:8080"
	config_get log_level main log_level "info"

	procd_open_instance
	procd_set_param command "$PROG" --listen "$listen" --log-level "$log_level"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="4096 4096"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "v2home"
}
